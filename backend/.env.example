# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (Railway provides DATABASE_URL automatically when you attach Postgres) ─
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freakn?schema=public

# ─── Redis (Railway: attach Redis plugin; for local use docker-compose) ───
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-32-byte-random
JWT_REFRESH_SECRET=replace-with-another-32-byte-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth (opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Freakn <hola@freakn.com>

# ─── Wompi (Colombia) ─────────────────────────────────────────────────────
# Sandbox keys at https://comercios.wompi.co
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# ─── Frontend / CORS ──────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Business rules ───────────────────────────────────────────────────────
TEACHER_PAYRATE_COP=15000

# ─── Object storage (MinIO local · S3 en Railway) ─────────────────────────
# Local dev (docker-compose levanta MinIO en :9000 + consola en :9001).
# En Railway: añade el plugin MinIO o S3 y reemplaza estas envs por las
# que provee el servicio.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=freakn-cms
# `true` para MinIO (path-style). En AWS S3 real déjalo en `false`.
S3_FORCE_PATH_STYLE=true
# Base URL pública para servir los objetos (lecturas anónimas o CDN).
S3_PUBLIC_URL=http://localhost:9000/freakn-cms
# TTL en segundos para signed URLs de subida.
S3_SIGNED_URL_TTL=900
