# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (Railway provides DATABASE_URL automatically when you attach Postgres) ─
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freakn?schema=public

# ─── Redis (Railway: attach Redis plugin; for local use docker-compose) ───
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-32-byte-random
JWT_REFRESH_SECRET=replace-with-another-32-byte-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth (opcional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Freakn <hola@freakn.com>

# ─── Wompi (Colombia) ─────────────────────────────────────────────────────
# Sandbox keys at https://comercios.wompi.co
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx

# ─── Frontend / CORS ──────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Business rules ───────────────────────────────────────────────────────
TEACHER_PAYRATE_COP=15000
