# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Database (Railway inyecta DATABASE_URL automáticamente) ───────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freakn?schema=public

# ─── Redis (Railway inyecta REDIS_URL) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-random-string
JWT_REFRESH_SECRET=change-me-different-32-chars-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Resend (email) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Freakn <hola@freakn.com>"

# ─── Wompi ─────────────────────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox

# ─── Misc ──────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TEACHER_PAYRATE_COP=15000
