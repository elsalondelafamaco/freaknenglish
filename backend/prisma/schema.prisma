// FreaknEnglish — Prisma schema (Postgres).
// Mirrors docs/data-model.md. Run: bun run prisma:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────
enum AppRole {
  student
  teacher
  admin
}

enum EnglishLevel {
  beginner
  intermediate
  advanced
}

enum SubscriptionStatus {
  pending
  active
  past_due
  canceled
  expired
  // Plan congelado por el admin: el estudiante no pierde el plan pero sale de
  // circulación (no se le generan clases ni ocupa franja del profe).
  paused
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
}

enum ClassStatus {
  scheduled
  validated
  no_show
  cancelled
  rescheduled
  // Congelada: el profe sabe que hay que mover la clase pero todavía no tiene
  // la nueva fecha. NO se auto-valida al pasar la hora ni cuenta para nómina;
  // se queda esperando a que se defina el nuevo horario.
  pending_reschedule
}

enum NotificationStatus {
  queued
  sent
  failed
}

// ─── Users & auth ─────────────────────────────────────────────────────────
model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String?       @map("password_hash")
  fullName        String        @map("full_name")
  phone           String?
  documentNumber  String?       @map("document_number")
  role            AppRole       @default(student)
  // Roles ADICIONALES al principal. Existe para el caso "un admin también da
  // clases": se le deja role=admin y extraRoles=[teacher] en vez de duplicar
  // la cuenta. Los permisos se evalúan siempre sobre role + extraRoles.
  extraRoles      AppRole[]     @default([]) @map("extra_roles")
  englishLevel    EnglishLevel? @map("english_level")
  avatarUrl       String?       @map("avatar_url")
  googleSub       String?       @unique @map("google_sub")
  emailVerifiedAt DateTime?     @map("email_verified_at")
  onboardedAt     DateTime?     @map("onboarded_at")
  schedulePreferences Json?     @map("schedule_preferences")
  scheduleAssignmentStatus String? @map("schedule_assignment_status")
  assignedTeacherId String?     @map("assigned_teacher_id")
  // Duración de cada clase del estudiante en minutos. null = estándar (50).
  classDurationMin Int?         @map("class_duration_min")
  disabledAt      DateTime?     @map("disabled_at")
  deletedAt       DateTime?     @map("deleted_at")
  // Admin pidió la encuesta NPS explícitamente (pending=true hasta responder).
  npsRequestedAt  DateTime?     @map("nps_requested_at")
  // Link de Meet/Zoom del estudiante, asignado por su profesor.
  meetingUrl      String?       @map("meeting_url")
  lastLoginAt     DateTime?     @map("last_login_at")
  setPasswordToken String?      @map("set_password_token")
  setPasswordTokenExpiresAt DateTime? @map("set_password_token_expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  subscription     Subscription?
  classesAsStudent Class[]       @relation("StudentClasses")
  classesAsTeacher Class[]       @relation("TeacherClasses")
  notes            ClassNote[]
  progress         LessonProgress[]
  attempts         CheckpointAttempt[]
  activityResults  ActivityResult[]
  /// Datos bancarios del profesor para la dispersión de nómina:
  /// { bankCode, accountType: 'SAVINGS'|'CHECKING', accountNumber }.
  /// Sin esto, el pago se registra como manual en vez de dispersarse.
  payoutAccount            Json?              @map("payout_account")
  checkpointUnlocks        CheckpointUnlock[] @relation("CheckpointUnlockStudent")
  checkpointUnlocksGranted CheckpointUnlock[] @relation("CheckpointUnlockGrantedBy")
  surveys          SatisfactionSurvey[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  paymentIntents   PaymentIntent[]
  availability     TeacherAvailability[]
  teacherSlots  ScheduleSlot[] @relation("TeacherSlots")
  studentSlots  ScheduleSlot[] @relation("StudentSlots")
  absences         TeacherAbsence[]
  boards           BoardMember[]

  assignedTeacher  User?         @relation("StudentTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  assignedStudents User[]        @relation("StudentTeacher")
  impersonationLogs ImpersonationLog[] @relation("ImpersonationAdmin")
  impersonatedBy   ImpersonationLog[] @relation("ImpersonationTarget")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─── Plans & subscriptions ────────────────────────────────────────────────
model Plan {
  id            String   @id // e.g. "3-dias", "4-dias", "5-dias"
  name          String
  daysPerWeek   Int      @map("days_per_week")
  priceCop      Int      @map("price_cop")
  priceUsd      Int?     @map("price_usd")
  features      Json     @default("[]")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  subscriptions  Subscription[]
  paymentIntents PaymentIntent[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(uuid())
  userId            String             @unique @map("user_id")
  planId            String             @map("plan_id")
  status            SubscriptionStatus @default(pending)
  startedAt         DateTime?          @map("started_at")
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAt          DateTime?          @map("cancel_at")
  canceledAt        DateTime?          @map("canceled_at")
  pausedAt          DateTime?          @map("paused_at")
  pauseReason       String?            @map("pause_reason")
  wompiCustomerId   String?            @map("wompi_customer_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// ─── Payments (Wompi) ─────────────────────────────────────────────────────
model PaymentIntent {
  id              String        @id @default(uuid())
  reference       String        @unique // sent to Wompi widget
  userId          String?       @map("user_id") // null until checkout completes for new users
  planId          String        @map("plan_id")
  amountInCents   Int           @map("amount_in_cents")
  currency        String        @default("COP")
  status          PaymentStatus @default(PENDING)
  customerEmail   String        @map("customer_email")
  customerName    String        @map("customer_name")
  customerPhone   String?       @map("customer_phone")
  customerDocument String?      @map("customer_document")
  scheduleJson   Json?   @map("schedule_json") // franjas elegidas [{weekday,hour}]
  passwordHash   String? @map("password_hash") // credenciales elegidas en checkout (argon2)
  assignmentMode String? @map("assignment_mode") // auto | manual
  wompiId         String?       @unique @map("wompi_id")
  approvedAt      DateTime?     @map("approved_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan   Plan            @relation(fields: [planId], references: [id])
  events PaymentEvent[]

  @@index([userId])
  @@index([status])
  @@map("payment_intents")
}

model PaymentEvent {
  id              String        @id @default(uuid())
  intentId        String        @map("intent_id")
  wompiEventId    String        @unique @map("wompi_event_id") // idempotency
  event           String        // transaction.updated, etc.
  status          PaymentStatus
  rawPayload      Json          @map("raw_payload")
  receivedAt      DateTime      @default(now()) @map("received_at")

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
  @@map("payment_events")
}

// ─── Classes ──────────────────────────────────────────────────────────────
model Class {
  id           String      @id @default(uuid())
  studentId    String      @map("student_id")
  teacherId    String?     @map("teacher_id")
  startsAt     DateTime    @map("starts_at")
  endsAt       DateTime    @map("ends_at")
  status       ClassStatus @default(scheduled)
  meetingUrl   String?     @map("meeting_url")
  topic        String?
  validatedAt  DateTime?   @map("validated_at")
  studentConfirmedAt DateTime? @map("student_confirmed_at")
  teacherValidatedAt DateTime? @map("teacher_validated_at")
  autoValidated Boolean @default(false) @map("auto_validated")
  cancelledAt  DateTime?   @map("cancelled_at")
  cancelReason String?     @map("cancel_reason")
  // Congelamiento a la espera de nueva fecha (status `pending_reschedule`).
  frozenAt     DateTime?   @map("frozen_at")
  freezeReason String?     @map("freeze_reason")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  student User       @relation("StudentClasses", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User?      @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  notes   ClassNote[]

  @@index([studentId, startsAt])
  @@index([teacherId, startsAt])
  @@map("classes")
}

model ClassNote {
  id        String   @id @default(uuid())
  classId   String?  @map("class_id")
  studentId String?  @map("student_id") // nota a nivel estudiante (sin clase)
  teacherId String   @map("teacher_id")
  rating    Int?     // (deprecado) 1..5
  pinned    Boolean  @default(false)
  notes     String
  createdAt DateTime @default(now()) @map("created_at")

  class   Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([studentId])
  @@map("class_notes")
}

// Compromiso recurrente semanal profesor<->estudiante. Fuente de verdad de
// ocupación para el matching de compra. pending = reserva de pago (20 min),
// active = vigente, held = retenido 5 días hábiles tras vencer la suscripción.
model ScheduleSlot {
  id            String    @id @default(uuid())
  teacherId     String    @map("teacher_id")
  studentId     String?   @map("student_id")
  intentId      String?   @map("intent_id") // reserva pre-pago (PaymentIntent)
  weekday       Int
  hour          Int
  status        String    @default("active") // pending | active | held
  holdExpiresAt DateTime? @map("hold_expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  teacher User  @relation("TeacherSlots", fields: [teacherId], references: [id], onDelete: Cascade)
  student User? @relation("StudentSlots", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, weekday, hour])
  @@index([studentId])
  @@index([intentId])
  @@index([status, holdExpiresAt])
  @@map("schedule_slots")
}

model TeacherAvailability {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  weekday   Int      // 0=Sun..6=Sat
  startsAt  String   @map("starts_at") // "08:00"
  endsAt    String   @map("ends_at")   // "18:00"
  timezone  String   @default("America/Bogota")

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_availability")
}

model TeacherAbsence {
  id        String   @id @default(uuid())
  teacherId String   @map("teacher_id")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  reason    String?

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_absences")
}

// ─── Learning ─────────────────────────────────────────────────────────────
model Module {
  id          String       @id
  level       EnglishLevel
  title       String
  description String?
  position    Int
  /// Unidad a la que pertenece dentro del nivel (agrupa los módulos en la UI).
  unit        Int?
  createdAt   DateTime     @default(now()) @map("created_at")

  lessons     Lesson[]
  checkpoints Checkpoint[]

  @@index([level, position])
  @@index([level, unit, position])
  @@map("modules")
}

model Lesson {
  id            String   @id
  moduleId      String   @map("module_id")
  title         String
  position      Int
  durationMin   Int      @map("duration_min")
  videoUrl      String?  @map("video_url")
  pdfUrl        String?  @map("pdf_url")
  slidesUrl     String?  @map("slides_url")
  downloadUrls  Json     @default("[]") @map("download_urls")
  /// Contenido HTML enriquecido (sanitizado en cliente).
  contentHtml   String?  @map("content_html")
  /// Notas internas / instrucciones para el estudiante.
  notes         String?
  /// Tipo dominante de la lección (video/pdf/slides/download/html).
  kind          String   @default("video")
  /// Marca la lección como CHECKPOINT: actúa de compuerta en la secuencia.
  /// Todo lo que va después (en el módulo y en los módulos siguientes) queda
  /// bloqueado hasta que el estudiante lo complete, y el checkpoint mismo no
  /// se abre hasta que un profesor se lo habilite.
  isCheckpoint  Boolean  @default(false) @map("is_checkpoint")

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  attachments LessonAttachment[]
  activityResults ActivityResult[]
  unlocks  CheckpointUnlock[]

  @@index([moduleId, position])
  @@map("lessons")
}

/// Archivos adjuntos a una lección, almacenados en MinIO/S3.
model LessonAttachment {
  id          String   @id @default(uuid())
  lessonId    String   @map("lesson_id")
  name        String
  /// Object key dentro del bucket de MinIO/S3.
  storageKey  String   @map("storage_key")
  /// URL pública (firmada o canónica) servida al frontend.
  url         String
  /// MIME type detectado en el upload.
  contentType String?  @map("content_type")
  sizeBytes   Int?     @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_attachments")
}

/// Material de apoyo para profesores: HTMLs que el admin sube y todos los
/// profes consultan. El contenido va en columna de texto y NO en el bucket
/// porque el bucket es de lectura pública (ver storage.service.ts): un archivo
/// ahí tendría URL abierta y esto es material interno.
model TeacherResource {
  id          String   @id @default(uuid())
  title       String
  description String?
  /// Agrupador libre ("Gramática", "Pronunciación"…). Sin categoría cae en
  /// "General" al listarse.
  category    String?
  contentHtml String   @map("content_html")
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, position])
  @@map("teacher_resources")
}

/// Habilitación de un checkpoint para un estudiante concreto. Sin una fila
/// aquí, el checkpoint aparece bloqueado: evita que el estudiante avance por
/// todo el contenido de una sentada sin pasar por su profesor.
model CheckpointUnlock {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  lessonId     String    @map("lesson_id")
  /// Profesor o admin que lo habilitó.
  unlockedById String    @map("unlocked_by_id")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Se llena al revocar (queda el registro histórico).
  revokedAt    DateTime? @map("revoked_at")

  user       User   @relation("CheckpointUnlockStudent", fields: [userId], references: [id], onDelete: Cascade)
  unlockedBy User   @relation("CheckpointUnlockGrantedBy", fields: [unlockedById], references: [id], onDelete: Cascade)
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("checkpoint_unlocks")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  completedAt DateTime? @map("completed_at")
  secondsWatched Int    @default(0) @map("seconds_watched")
  /// Posición en la lección interactiva donde quedó la última clase. Una
  /// lección puede tomar dos o tres clases: sin esto, cada clase volvía a
  /// empezar en el primer slide. Se guarda contra el ESTUDIANTE, no contra
  /// quien tiene la pantalla abierta — normalmente el profe, compartiendo
  /// pantalla.
  ///
  /// Es texto y no número porque las lecciones no navegan todas igual: unas
  /// usan un índice ("8") y otras el id del slide ("slide-game"). Se guarda tal
  /// cual lo reporta la lección y se le devuelve igual; la plataforma no
  /// interpreta el valor.
  lastSlideRef String?  @map("last_slide_ref")
  /// @deprecated Sustituida por lastSlideRef. Se deja para no forzar un borrado
  /// de columna en el arranque de producción (`prisma db push`); se puede
  /// quitar en una migración tranquila.
  lastSlide   Int?      @map("last_slide")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

/// Resultado de una actividad interactiva dentro de una lección HTML.
/// Las lecciones estandarizadas reportan vía el bridge `FreaknActivity.submit()`
/// (postMessage → LessonViewer → API). Una fila por (user, lesson, activity),
/// re-intentos actualizan la fila (se guarda el último intento + contador).
model ActivityResult {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  lessonId   String   @map("lesson_id")
  /// Id estable de la actividad dentro del HTML (p.ej. "quiz", "matching-1").
  activityId String   @map("activity_id")
  /// Título legible de la actividad (lo reporta el HTML).
  title      String?
  score      Int?     // puntos obtenidos
  maxScore   Int?     @map("max_score")
  /// Respuestas estandarizadas: [{ id, question, answer, correct?, expected? }]
  answers    Json     @default("[]")
  attempts   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, activityId])
  @@index([lessonId])
  @@map("activity_results")
}

model Checkpoint {
  id           String       @id
  moduleId     String       @map("module_id")
  fromLevel    EnglishLevel @map("from_level")
  toLevel     EnglishLevel @map("to_level")
  passingScore Int          @map("passing_score") // %
  /// Preguntas tipadas — ver checkpoint-questions.ts (single, multi, truefalse,
  /// fill, order, match, dragwords). Legacy sin `type` = single.
  questions    Json
  /// { allowRetryAfterPass?, maxAttempts?, cooldownHours?, shuffleQuestions?,
  ///   showAnswers?, timeLimitMin? } — ver DEFAULT_CHECKPOINT_SETTINGS.
  settings     Json         @default("{}")

  module   Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attempts CheckpointAttempt[]

  @@map("checkpoints")
}

model CheckpointAttempt {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  checkpointId  String     @map("checkpoint_id")
  score         Int        // %
  passed        Boolean
  answers       Json
  createdAt     DateTime   @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([userId, checkpointId])
  @@map("checkpoint_attempts")
}

// ─── Surveys ──────────────────────────────────────────────────────────────
model SatisfactionSurvey {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  score     Int      // 0..10 NPS
  teacherScore  Int?   @map("teacher_score")  // 1..5
  contentScore  Int?   @map("content_score")  // 1..5
  platformScore Int?   @map("platform_score") // 1..5
  comment   String?
  period    String   // YYYY-MM
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("satisfaction_surveys")
}

// ─── Notifications ────────────────────────────────────────────────────────
model Notification {
  id         String             @id @default(uuid())
  userId     String?            @map("user_id")
  toEmail    String             @map("to_email")
  channel    String             @default("email") // email | sms | push
  template   String             // welcome, reminder_24h, reminder_1h, abandoned_cart, nps_monthly, renewal_3d, payment_success, class_rescheduled, class_cancelled, teacher_assigned
  type       String             @default("system") // system | payment | class | teacher | learning
  title      String?            // short in-app title
  body       String?            // short in-app body
  linkUrl    String?            @map("link_url")
  subject    String
  status     NotificationStatus @default(queued)
  dedupeKey  String             @unique @map("dedupe_key")
  vars       Json               @default("{}")
  providerId String?            @map("provider_id")
  sentAt     DateTime?          @map("sent_at")
  readAt     DateTime?          @map("read_at")
  error      String?
  createdAt  DateTime           @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ─── Admin / settings ─────────────────────────────────────────────────────
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model PayrollRun {
  id        String   @id @default(uuid())
  period    String   // YYYY-MM
  teacherId String   @map("teacher_id")
  classes   Int
  rateCop   Int      @map("rate_cop")
  /// Calculado: clases × tarifa. No incluye el ajuste.
  amountCop Int      @map("amount_cop")
  /// Ajuste manual sobre el valor final (positivo bonifica, negativo descuenta).
  adjustmentCop  Int     @default(0) @map("adjustment_cop")
  /// Por qué se ajustó. Obligatorio en la UI para que quede el rastro.
  adjustmentNote String? @map("adjustment_note")
  status    String   @default("pending") // pending | paid
  /// Cómo se pagó: `wompi` (dispersión) o `manual` (registrado por el admin).
  paidMethod String? @map("paid_method")
  /// Referencia de la transferencia (id de Wompi o nota del admin).
  payoutRef  String? @map("payout_ref")
  /// Si la dispersión falló, aquí queda el motivo; el pago igual se registra.
  payoutError String? @map("payout_error")
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([period, teacherId])
  @@map("payroll_runs")
}

// ─── Realtime board ───────────────────────────────────────────────────────
model Board {
  id          String   @id @default(uuid())
  classId     String?  @unique @map("class_id")
  ownerId     String   @map("owner_id")
  name        String   @default("Untitled")
  snapshot    Json     @default("{}") // last persisted state
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members BoardMember[]
  ops     BoardOp[]
  pages   BoardPage[]

  @@map("boards")
}

model BoardMember {
  id       String  @id @default(uuid())
  boardId  String  @map("board_id")
  userId   String  @map("user_id")
  role     String  @default("editor") // editor | viewer
  joinedAt DateTime @default(now()) @map("joined_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@map("board_members")
}

model BoardOp {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  userId    String   @map("user_id")
  clientOpId String  @map("client_op_id") // idempotency key from client
  op        Json     // free-form op payload (CRDT/event)
  seq       Int      // monotonic per board
  createdAt DateTime @default(now()) @map("created_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, seq])
  @@unique([boardId, clientOpId])
  @@index([boardId, createdAt])
  @@map("board_ops")
}

model BoardPage {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  title     String   @default("Página")
  position  Int      @default(0)
  kind      String   @default("doc") // doc | canvas | mixed
  yjsState  Bytes?   @map("yjs_state")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  ops   BoardPageOp[]

  @@index([boardId, position])
  @@map("board_pages")
}

model BoardPageOp {
  id         String   @id @default(uuid())
  pageId     String   @map("page_id")
  userId     String   @map("user_id")
  clientOpId String   @map("client_op_id")
  update     Bytes
  seq        Int
  createdAt  DateTime @default(now()) @map("created_at")

  page BoardPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, seq])
  @@unique([pageId, clientOpId])
  @@index([pageId, createdAt])
  @@map("board_page_ops")
}

model BoardPageVersion {
  id        String   @id @default(uuid())
  pageId    String   @map("page_id")
  createdBy String   @map("created_by")
  label     String?
  state     Bytes
  sizeBytes Int      @default(0) @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([pageId, createdAt])
  @@map("board_page_versions")
}

/// Auditoría de impersonación admin → usuario.
model ImpersonationLog {
  id          String    @id @default(uuid())
  adminId     String    @map("admin_id")
  targetId    String    @map("target_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  ip          String?
  userAgent   String?   @map("user_agent")

  admin       User      @relation("ImpersonationAdmin",  fields: [adminId],  references: [id])
  target      User      @relation("ImpersonationTarget", fields: [targetId], references: [id])

  @@index([adminId, startedAt])
  @@index([targetId, startedAt])
  @@map("impersonation_logs")
}

/// Cache diario de la TRM (Superfinanciera / datos.gov.co SODA).
model TrmRate {
  id         String   @id
  validFrom  DateTime @map("valid_from")
  valueCop   Decimal  @map("value_cop") @db.Decimal(12, 4)
  source     String   @default("superfinanciera")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@index([validFrom(sort: Desc)])
  @@map("trm_rates")
}
