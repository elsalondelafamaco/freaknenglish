# Frontend (Vite) — copy to storefront/.env.local

# Backend API base URL (Nest)
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000

# Wompi public key for the Checkout Widget
VITE_WOMPI_PUBLIC_KEY=pub_test_xxx

# Optional: Google client (for the "Sign in with Google" button redirect target)
VITE_GOOGLE_CLIENT_ID=

# Public marketing URL used in canonical/OG tags
VITE_PUBLIC_SITE_URL=http://localhost:5173
